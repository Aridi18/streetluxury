# ---- Required ----
# PostgreSQL connection string
DATABASE_URL="postgresql://dd:CHANGE_ME@localhost:5432/digital_district"
# Public base URL of the store (no trailing slash). Used in emails, WhatsApp messages and payment redirects.
APP_URL="https://digitaldistrict.store"
# 32-byte key, base64. Encrypts licence keys, delivered credentials and other secrets at rest.
# Generate with:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=""
# Secret used by the scheduler to call /api/cron. Generate with: openssl rand -hex 32
CRON_SECRET=""
# Where uploaded files are stored (product images, digital files, payment proofs)
STORAGE_DIR="./storage"

# ---- Email (optional; without it, emails are logged as "not sent" and everything else still works) ----
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=""
EMAIL_FROM="Digital District <no-reply@digitaldistrict.store>"
# Where owner alerts (new orders, low stock) are emailed
OWNER_ALERT_EMAIL=""

# ---- Online card payments (optional) ----
# Mastercard Payment Gateway Services hosted checkout, as offered by Lebanese acquirers such as areeba.
# Leave empty to keep online card payment unavailable.
MPGS_GATEWAY_URL=""
MPGS_MERCHANT_ID=""
MPGS_API_PASSWORD=""
MPGS_API_VERSION="100"
MPGS_WEBHOOK_SECRET=""
