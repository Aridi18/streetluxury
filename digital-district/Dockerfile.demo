# Single-container demo image (used by the free Render demo in /render.yaml).
# On start it applies migrations, imports the catalog (only the first time — the seed never overwrites edits),
# prints a one-time owner invitation link in the logs, then starts the store.
# For the real store use Dockerfile + docker-compose.yml (see docs/DEPLOYMENT.md).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npx prisma generate && npx next build && cp -r .next/static .next/standalone/.next/static
ENV NODE_ENV=production STORAGE_DIR=/app/storage HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx prisma/seed.ts && npx tsx scripts/first-run.ts && node .next/standalone/server.js"]
