# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64. Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes every stored recording unreadable. Back it up separately from the data.
AS_STORAGE_ENCRYPTION_KEY=
AS_COOKIE_SECURE=true
# Set when the app is behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Host.
AS_TRUST_PROXY_HEADERS=true
AS_ALLOW_REGISTRATION=true
AS_MAX_UPLOAD_MB=100
AS_MAX_DURATION_SECONDS=1800
AS_DEFAULT_RETENTION_DAYS=30
AS_MAX_RETENTION_DAYS=365
# Synthetic-speech detectors to enable on the worker (comma-separated). Detectors whose weights
# are missing report "Detection model not configured". The AntiDeepfake weights are CC BY-NC-SA 4.0
# (non-commercial): remove it here for commercial deployments unless you hold a licence.
AS_SYNTHETIC_DETECTORS=antideepfake-w2v2-small,aasist
AS_TORCH_THREADS=0
# Object storage: "local" (encrypted files on the objects volume) or "s3" (private bucket).
AS_STORAGE_BACKEND=local
# AS_S3_BUCKET=
# AS_S3_REGION=
# AS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
